{
  "name": "@shipyard402/web-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js dashboard for launching and monitoring Shipyard402 runs.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "start": "node .next/standalone/apps/web-dashboard/server.js",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shipyard402/public-api-client": "workspace:*",
    "gsap": "^3.15.0",
    "lucide-react": "^1.30.0",
    "motion": "^12.43.0",
    "next": "16.3.0",
    "ogl": "1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.7",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
