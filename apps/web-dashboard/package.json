{
  "name": "@shipyard402/web-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build && node scripts/prepare-standalone.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "format:check": "next typegen && tsc -p tsconfig.json --noEmit",
    "start": "node .next/standalone/apps/web-dashboard/server.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shipyard402/public-api-client": "workspace:*",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
