{
  "name": "@shipyard402/api-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Public REST API (Vercel) for creating Shipyard402 runs/quotes and serving evidence to the web dashboard.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@shipyard402/goat-flow-adapter": "workspace:*",
    "@shipyard402/goat-network-config": "workspace:*",
    "@shipyard402/persistence-postgres": "workspace:*",
    "@shipyard402/quote-engine": "workspace:*",
    "@shipyard402/run-domain": "workspace:*",
    "@shipyard402/x402-payments": "workspace:*",
    "fastify": "5.11.2",
    "viem": "2.55.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
