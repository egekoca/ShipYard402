{
  "name": "@shipyard402/api-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "format:check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@shipyard402/goat-flow-adapter": "workspace:*",
    "@shipyard402/goat-network-config": "workspace:*",
    "@shipyard402/persistence-postgres": "workspace:*",
    "@shipyard402/quote-engine": "workspace:*",
    "@shipyard402/run-domain": "workspace:*",
    "@shipyard402/x402-payments": "workspace:*",
    "fastify": "5.11.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
