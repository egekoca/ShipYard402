{
  "name": "@shipyard402/payment-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Long-running worker that reconciles GOAT x402 payments against on-chain confirmations.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "maintenance:expire-stale-orders": "tsx --env-file-if-exists=../../.env src/expire-stale-orders.ts"
  },
  "dependencies": {
    "@shipyard402/bot-chain-adapter": "workspace:*",
    "@shipyard402/bot-chain-network-config": "workspace:*",
    "@shipyard402/goat-chain-reader": "workspace:*",
    "@shipyard402/goat-flow-adapter": "workspace:*",
    "@shipyard402/goat-network-config": "workspace:*",
    "@shipyard402/payment-reconciliation": "workspace:*",
    "@shipyard402/persistence-postgres": "workspace:*",
    "viem": "2.55.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
