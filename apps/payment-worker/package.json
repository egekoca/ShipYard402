{
  "name": "@shipyard402/payment-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "format:check": "tsc -p tsconfig.json --noEmit",
