    "@shipyard402/payment-reconciliation": "workspace:*",
    "@shipyard402/persistence-postgres": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
