{
  "name": "@shipyard402/x402-demo-target",
  "version": "0.1.0",
  "private": true,
  "description": "Demo x402-protected tool endpoint (vulnerable and protected modes) used to exercise the orchestrator pipeline.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "format:check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shipyard402/goat-network-config": "workspace:*",
    "@shipyard402/protected-delivery-runner": "workspace:*",
    "fastify": "5.11.2",
    "viem": "2.55.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
