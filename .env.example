APP_ENV=development
# Signs/verifies session bearer tokens for run/quote ownership checks (see
# apps/api-gateway/src/session-auth.ts). Required in production; generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
SESSION_SIGNING_SECRET=
PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
NEXT_PUBLIC_SHIPYARD_API_URL=http://127.0.0.1:3001
# Separate BOT Chain API deployment/database. The dashboard merges both public catalogs and routes
# a selected BOT listing back to this backend for quote, run, payment submission and polling.
NEXT_PUBLIC_BOTCHAIN_API_URL=http://127.0.0.1:3011
# Wallet network requested by the dashboard before a quote exists: 2345 mainnet, 48816 Testnet3.
NEXT_PUBLIC_DEFAULT_CHAIN_ID=2345
LOG_LEVEL=info
DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5432/shipyard
DATABASE_TLS=false
REDIS_URL=redis://127.0.0.1:6379

GOAT_MAINNET_RPC_URL=https://rpc.goat.network
GOAT_TESTNET_RPC_URL=https://rpc.testnet3.goat.network
GOAT_NETWORK_ENVIRONMENT=mainnet

# GOAT Flow merchant profiles are isolated by network. GOAT_NETWORK_ENVIRONMENT selects exactly
# one complete group; the unselected group remains stored but is ignored by the running process.
GOATX402_TESTNET3_API_URL=https://flow-api.testnet3.goat.network
GOATX402_TESTNET3_MERCHANT_ID=
GOATX402_TESTNET3_API_KEY=
GOATX402_TESTNET3_API_SECRET=
GOATX402_TESTNET3_TOKEN_ADDRESS=
GOATX402_TESTNET3_TOKEN_SYMBOL=
GOATX402_TESTNET3_TOKEN_DECIMALS=
GOATX402_TESTNET3_RECEIVING_ADDRESS=
GOATX402_TESTNET3_MINIMUM_ATOMIC_AMOUNT=
GOATX402_TESTNET3_MAXIMUM_ATOMIC_AMOUNT=

GOATX402_MAINNET_API_URL=https://flow-api.goat.network
GOATX402_MAINNET_MERCHANT_ID=
GOATX402_MAINNET_API_KEY=
GOATX402_MAINNET_API_SECRET=
GOATX402_MAINNET_TOKEN_ADDRESS=
GOATX402_MAINNET_TOKEN_SYMBOL=
GOATX402_MAINNET_TOKEN_DECIMALS=
GOATX402_MAINNET_RECEIVING_ADDRESS=
GOATX402_MAINNET_MINIMUM_ATOMIC_AMOUNT=
GOATX402_MAINNET_MAXIMUM_ATOMIC_AMOUNT=

# Legacy single-profile variables remain supported so existing local/Testnet3 setups keep working.
# New configurations should use the two network-scoped groups above.
# GOATX402_API_URL=
# GOATX402_MERCHANT_ID=
# GOATX402_API_KEY=
# GOATX402_API_SECRET=
# GOATX402_TOKEN_ADDRESS=
# GOATX402_TOKEN_SYMBOL=
# GOATX402_TOKEN_DECIMALS=
# GOATX402_RECEIVING_ADDRESS=
# GOATX402_MINIMUM_ATOMIC_AMOUNT=
# GOATX402_MAXIMUM_ATOMIC_AMOUNT=

# --- BOT Chain (apps/api-gateway, apps/payment-worker, apps/orchestrator-worker, x402 demo target) ---
# NETWORK selects the chain the workers and the demo target settle on. 'goat' (the default)
# reproduces the GOAT behavior above; 'bot-chain-testnet' switches to BOT Chain testnet (968).
# NETWORK=bot-chain-testnet
# BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
# MERCHANT_ADAPTER selects how a customer payment is taken: 'goat-flow' uses GOAT's order API,
# 'bot-chain-direct' verifies the ERC-20 transfer straight from BOT Chain with no merchant API.
# MERCHANT_ADAPTER=bot-chain-direct
# BOT_NETWORK_ENVIRONMENT=botChainTestnet
# BOTX402_MERCHANT_ID=
# BOTX402_TOKEN_ADDRESS=
# BOTX402_TOKEN_SYMBOL=
# BOTX402_TOKEN_DECIMALS=
# BOTX402_RECEIVING_ADDRESS=
# BOTX402_MINIMUM_ATOMIC_AMOUNT=
# BOTX402_MAXIMUM_ATOMIC_AMOUNT=

PAYMENT_WORKER_ID=payment-worker:local
PAYMENT_POLL_INTERVAL_MS=2000
PAYMENT_LEASE_SECONDS=60

# Production keys must be provided through an isolated signer/KMS integration.
SHIPYARD_PAYER_SIGNER_REF=
SHIPYARD_ATTESTOR_SIGNER_REF=

# --- x402 demo target (apps/x402-demo-target) ---
# A controlled demo paid resource used to prove the payment-proof replay check end to end.
# Not a real GOAT Flow merchant — see apps/x402-demo-target/src for its scope and limits.
DEMO_MODE=V2_PROTECTED
DEMO_TARGET_RECEIVING_ADDRESS=
# The EIP-3009 settlement asset the target advertises in its 402, its EIP-712 domain, the price it
# charges, and the account that relays a payer's signed authorization on-chain (it needs gas, and
# never holds the payer's balance).
DEMO_TARGET_TOKEN_ADDRESS=
DEMO_TARGET_TOKEN_NAME=Shipyard Testnet Token
DEMO_TARGET_TOKEN_VERSION=1
DEMO_TARGET_PRICE_ATOMIC=
DEMO_TARGET_MAX_TIMEOUT_SECONDS=300
DEMO_TARGET_SETTLER_PRIVATE_KEY=
# Optional: signs every /paid/resource response so the orchestrator can verify it actually came
# from this process (see DEMO_TARGET_PROVIDER_SIGNER_ADDRESS below, which must be this key's address).
# PROVIDER_SIGNER_PRIVATE_KEY=

# --- orchestrator worker (apps/orchestrator-worker) ---
# Drives a FUNDED run through ANALYZING..ATTESTING. See docs/state-machine.md.
# Development/testnet only -- production refuses to boot with a raw key here (see runtime-config.ts).
ORCHESTRATOR_SIGNER_PRIVATE_KEY=
ORCHESTRATOR_TOOL_RECEIPT_SIGNER_PRIVATE_KEY=
# Production alternative: an encrypted keystore (see scripts/testnet/encrypt-keystore.mjs) instead
# of the raw keys above.
# ORCHESTRATOR_SIGNER_KEYSTORE_PATH=
# ORCHESTRATOR_SIGNER_KEYSTORE_PASSWORD=
# ORCHESTRATOR_TOOL_RECEIPT_SIGNER_KEYSTORE_PATH=
# ORCHESTRATOR_TOOL_RECEIPT_SIGNER_KEYSTORE_PASSWORD=
ORCHESTRATOR_MAX_PROCUREMENT_SPEND_ATOMIC=
# Comma-separated settlement assets this worker may pay a target in. Required: the target writes
# its own 402 challenge, so without this the asset -- and the EIP-712 verifying contract signed
# with it -- would be chosen by whichever endpoint the customer pointed the run at.
ORCHESTRATOR_PROCUREMENT_ALLOWED_ASSETS=
SHIPYARD_RUN_REGISTRY_ADDRESS=
SHIPYARD_AGENT_ID=shipyard:orchestrator
ORCHESTRATOR_MANDATORY_SCENARIOS=payment-proof-replay
# The demo target's current public URL. Nothing in the worker reads these any more -- the target is
# per-run now, resolved from the onboarded service -- but scripts/local-backend-up.sh records the
# tunnel here so operators and the self-test scripts have one place to look.
DEMO_TARGET_BASE_URL=
DEMO_TARGET_HOST=
DEMO_TARGET_TOOL_AGENT_ID=
DEMO_TARGET_TOOL_VERSION=x402-demo-target@0.1.0
# Optional: the address PROVIDER_SIGNER_PRIVATE_KEY (above, in x402-demo-target's own config)
# corresponds to. Leaving this unset means responses aren't cross-checked against a registered
# signer at all -- set once you actually want that verification enforced.
# DEMO_TARGET_PROVIDER_SIGNER_ADDRESS=
IPFS_API_URL=http://127.0.0.1:5001
ORCHESTRATOR_REFUNDS_ENABLED=false
ORCHESTRATOR_WORKER_ID=orchestrator-worker:local
ORCHESTRATOR_POLL_INTERVAL_MS=3000
ORCHESTRATOR_LEASE_SECONDS=120

# --- GOAT mainnet -> BNB mainnet bridge-then-pay PoC ---
# Keep disabled until every value below has been reviewed. Enabling this mode can move real funds.
# disabled | goat-bnb-usdt | goat-bnb-usdc | bnb-prefunded
# The goat-bnb-* modes bridge GOAT funds to BNB first and require GOAT mainnet. 'bnb-prefunded'
# pays from a BNB wallet that already holds the settlement asset -- the only way to reach a target
# priced in something no Stargate route delivers, and usable alongside any GOAT environment.
CROSS_CHAIN_PROCUREMENT_MODE=disabled
# BNB mainnet RPC used by the destination payer and the controlled x402 target.
BNB_RPC_URL=
# HTTPS URL of the BNB x402 paid resource to buy. A loopback target may be exposed through an
# HTTPS tunnel for a local PoC; the payer intentionally rejects plaintext non-loopback endpoints.
BNB_X402_ENDPOINT=
# OPTIONAL. Pins the recipient, which is how a target we control stays controlled. Leave it unset
# to pay a third-party service, whose recipient comes from its own 402 challenge -- the payment is
# still bounded by the network, the bridged asset, and BNB_X402_TARGET_AMOUNT_ATOMIC below.
BNB_X402_PAY_TO=
# Development PoC only. This destination wallet receives bridged USDT and signs x402 Permit2 data.
# It also needs a small BNB balance for the one-time exact Permit2 approval transaction.
BNB_X402_PAYER_PRIVATE_KEY=
# 'bnb-prefunded' only: the ERC-20 the payer already holds and will spend. Canonical BNB USDT and
# USDC are plain ERC-20s (Permit2 only); USD1 (0x8d0D000Ee44948FC98c9B98A4FA4921476f08B0d) is the
# one that implements EIP-3009, which needs no gas and no approval on the payer's side.
BNB_X402_SETTLEMENT_ASSET=
# What one target purchase draws from the run's tool budget, in the FUNDING rail's units. It cannot
# be derived from the destination amount -- different asset, different decimals. Bridged modes
# default it to CROSS_CHAIN_SOURCE_BRIDGE_AMOUNT_ATOMIC; 'bnb-prefunded' must state it.
CROSS_CHAIN_POLICY_COST_ATOMIC=
# GOAT USDT uses 6 decimals; canonical BNB USDT uses 18 decimals.
CROSS_CHAIN_SOURCE_BRIDGE_AMOUNT_ATOMIC=
# Hard ceiling for one target payment, not a fixed price. The target publishes what it charges and
# anything at or below this is payable; anything above is refused before any approval is granted.
BNB_X402_TARGET_AMOUNT_ATOMIC=
# Hard safety ceilings. No bridge quote or Permit2 approval may exceed these values.
STARGATE_MAX_NATIVE_FEE_WEI=
BNB_MAX_APPROVAL_GAS_COST_WEI=
STARGATE_MAX_BRIDGE_WAIT_SECONDS=1800
LAYERZERO_SCAN_API_URL=https://scan.layerzero-api.com/v1/

# Controlled BNB x402 v2 target + loopback-only facilitator (apps/bnb-x402-target).
BNB_X402_HOST=127.0.0.1
BNB_X402_PORT=3012
BNB_FACILITATOR_HOST=127.0.0.1
BNB_FACILITATOR_PORT=3013
# This separate wallet settles Permit2 payments and needs BNB gas. Do not reuse the payer key.
BNB_FACILITATOR_PRIVATE_KEY=
BNB_X402_PRICE_ATOMIC=
BNB_X402_MAX_PRICE_ATOMIC=

# AI risk-classification layer (ADR-0006: proposes only, never authorizes spend).
OPENAI_API_KEY=
OPENAI_MODEL=
