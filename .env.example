APP_ENV=development
PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SHIPYARD_API_URL=http://127.0.0.1:3001
LOG_LEVEL=info
DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5432/shipyard
DATABASE_TLS=false
REDIS_URL=redis://127.0.0.1:6379

GOAT_MAINNET_RPC_URL=https://rpc.goat.network
GOAT_TESTNET_RPC_URL=https://rpc.testnet3.goat.network
GOAT_NETWORK_ENVIRONMENT=mainnet
GOATX402_API_URL=https://flow-api.goat.network
GOATX402_MERCHANT_ID=
GOATX402_API_KEY=
GOATX402_API_SECRET=
GOATX402_TOKEN_ADDRESS=
GOATX402_TOKEN_SYMBOL=
GOATX402_TOKEN_DECIMALS=
GOATX402_RECEIVING_ADDRESS=
GOATX402_MINIMUM_ATOMIC_AMOUNT=
GOATX402_MAXIMUM_ATOMIC_AMOUNT=

PAYMENT_WORKER_ID=payment-worker:local
PAYMENT_POLL_INTERVAL_MS=2000
PAYMENT_LEASE_SECONDS=60

# Production keys must be provided through an isolated signer/KMS integration.
SHIPYARD_PAYER_SIGNER_REF=
SHIPYARD_ATTESTOR_SIGNER_REF=

# --- x402 demo target (apps/x402-demo-target) ---
# A controlled demo paid resource used to prove the payment-proof replay check end to end.
# Not a real GOAT Flow merchant — see apps/x402-demo-target/src for its scope and limits.
DEMO_MODE=V2_PROTECTED
DEMO_RECEIPT_SECRET=
DEMO_TARGET_RECEIVING_ADDRESS=
DEMO_TARGET_MINIMUM_ATOMIC_AMOUNT=
DEMO_TARGET_MINIMUM_CONFIRMATIONS=1

# --- orchestrator worker (apps/orchestrator-worker) ---
# Drives a FUNDED run through ANALYZING..ATTESTING. See docs/state-machine.md.
ORCHESTRATOR_SIGNER_PRIVATE_KEY=
ORCHESTRATOR_TOOL_RECEIPT_SIGNER_PRIVATE_KEY=
ORCHESTRATOR_MAX_PROCUREMENT_SPEND_ATOMIC=
SHIPYARD_RUN_REGISTRY_ADDRESS=
SHIPYARD_AGENT_ID=shipyard:orchestrator
ORCHESTRATOR_MANDATORY_SCENARIOS=payment-proof-replay
DEMO_TARGET_BASE_URL=
DEMO_TARGET_HOST=
DEMO_TARGET_TOOL_AGENT_ID=
DEMO_TARGET_TOOL_VERSION=x402-demo-target@0.1.0
IPFS_API_URL=http://127.0.0.1:5001
ORCHESTRATOR_WORKER_ID=orchestrator-worker:local
ORCHESTRATOR_POLL_INTERVAL_MS=3000
ORCHESTRATOR_LEASE_SECONDS=120

# AI risk-classification layer (ADR-0006: proposes only, never authorizes spend).
OPENAI_API_KEY=
OPENAI_MODEL=
