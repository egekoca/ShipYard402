{
  "name": "@shipyard402/persistence-postgres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "format:check": "tsc -p tsconfig.json --noEmit",
    "migrate": "node scripts/migrate.mjs ../../infra/migrations",
    "test": "vitest run",
    "test:postgres": "TEST_DATABASE_URL=postgresql://shipyard:shipyard@127.0.0.1:5432/shipyard vitest run --no-file-parallelism src/*.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@shipyard402/goat-flow-adapter": "workspace:*",
    "@shipyard402/goat-network-config": "workspace:*",
    "@shipyard402/payment-reconciliation": "workspace:*",
    "@shipyard402/quote-engine": "workspace:*",
    "@shipyard402/run-domain": "workspace:*",
    "@shipyard402/x402-payments": "workspace:*",
    "pg": "8.22.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
